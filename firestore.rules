rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    // Listings: everyone signed in can browse; only the seller can create/edit/delete
    match /listings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.sellerId == request.auth.uid;
    }

    // Chats: only the two participants can see or write
    match /chats/{chatId} {
      allow get, list: if request.auth != null
                    && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && (!exists(chatPath(chatId))
                        || request.auth.uid in get(chatPath(chatId)).data.participants);
        allow create: if request.auth != null
                    && request.resource.data.senderId == request.auth.uid
                    && request.auth.uid in get(chatPath(chatId)).data.participants;
      }
    }
  }
}